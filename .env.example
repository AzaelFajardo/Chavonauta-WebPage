# Autenticación y sesiones
# Obligatorio en producción. Generar con: openssl rand -base64 48
ADMIN_JWT_SECRET=

# Bootstrap inicial (solo primera instalación; después se administra desde /admin/seguridad)
# Si no se define ADMIN_INITIAL_PASSWORD en producción, el acceso administrativo
# permanece deshabilitado hasta configurarla y reiniciar el servicio.
ADMIN_INITIAL_PASSWORD=
ADMIN_BOOTSTRAP_EMAILS=

# Persistencia (recomendado en producción: rutas fuera del directorio de la aplicación)
DATABASE_PATH=
UPLOADS_DIR=

# URL pública del sitio (usada para metadatos y enlaces absolutos)
SITE_URL=
